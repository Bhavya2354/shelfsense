# Copy to .env and fill in. Never commit .env.

# Runtime
LOG_LEVEL=INFO
LOG_FORMAT=console

# Storage
DATA_DIR=

# HTTP client tunables (optional, defaults shown)
# HTTP_TIMEOUT_SECONDS=30
# HTTP_MAX_RETRIES=5
# HTTP_BACKOFF_SECONDS=1.0

# Kaggle (token read from KAGGLE_API_TOKEN or ~/.kaggle/access_token)
KAGGLE_COMPETITION=

# FRED (free key: https://fredaccount.stlouisfed.org/apikeys)
FRED_API_KEY=
FRED_BASE_URL=
FRED_OIL_SERIES_ID=

# Open-Meteo (no key needed)
OPEN_METEO_ARCHIVE_URL=
OPEN_METEO_GEOCODING_URL=
WEATHER_COUNTRY_CODE=
