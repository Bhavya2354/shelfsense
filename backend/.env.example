# Copy to .env and fill in. Never commit .env.

# Runtime
LOG_LEVEL=INFO
LOG_FORMAT=console

# Storage
DATA_DIR=

# HTTP client tunables (optional, defaults shown)
# HTTP_TIMEOUT_SECONDS=30
# HTTP_MAX_RETRIES=5
# HTTP_BACKOFF_SECONDS=1.0

# Favorita competition archive (public mirror of the original CSVs)
FAVORITA_ARCHIVE_URL=

# FRED (free key: https://fredaccount.stlouisfed.org/apikeys)
FRED_API_KEY=
FRED_BASE_URL=
FRED_OIL_SERIES_ID=

# Open-Meteo (no key needed)
OPEN_METEO_ARCHIVE_URL=
OPEN_METEO_GEOCODING_URL=
WEATHER_COUNTRY_CODE=

# Database (pipeline and migrations; read-write)
DATABASE_URL=
# DATABASE_POOL_SIZE=5
# DATABASE_STATEMENT_TIMEOUT_MS=300000

# Forecasting
CHRONOS_MODEL_ID=

# API (connects as a member of the read-only api_readonly role)
API_DATABASE_URL=
# JSON list, e.g. ["http://localhost:5173"]
API_CORS_ORIGINS=
